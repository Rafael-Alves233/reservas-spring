### =============================================================
### ColabSpace - Bateria de requisicoes
### Rode com a aplicacao no ar (./mvnw spring-boot:run).
### Os ids 1-4 (salas) e 1-3 (colaboradores) vem do seed.
### =============================================================

@baseUrl = http://localhost:8080/api


### =============================================================
### 1. SEED - confirma que a base subiu populada
### =============================================================

### Lista salas (esperado: as 4 do seed)
GET {{baseUrl}}/salas

> {%
    client.test("200", () => client.assert(response.status === 200));
    client.test("seed carregou 4 salas", () =>
        client.assert(response.body.length >= 4, "esperado ao menos 4 salas"));
%}

### Detalha a Sala Apollo
GET {{baseUrl}}/salas/1

> {%
    client.test("200", () => client.assert(response.status === 200));
    client.test("e a Apollo", () => client.assert(response.body.nome === "Sala Apollo"));
%}

### Detalha colaborador do seed
GET {{baseUrl}}/colaboradores/1

> {%
    client.test("200", () => client.assert(response.status === 200));
    client.test("e a Ana", () => client.assert(response.body.nome === "Ana Souza"));
%}


### =============================================================
### 2. CAMINHO FELIZ
### =============================================================

### Cadastra sala -> 201 + Location
POST {{baseUrl}}/salas
Content-Type: application/json

{
  "nome": "Sala Teste {{$randomInt}}",
  "capacidade": 8,
  "andar": 4,
  "recursos": ["TV", "LOUSA"]
}

> {%
    client.test("201", () => client.assert(response.status === 201));
    client.test("header Location presente", () =>
        client.assert(response.headers.valueOf("Location") != null, "faltou o Location"));
    client.test("id gerado", () => client.assert(response.body.id != null));
    client.global.set("salaId", response.body.id);
%}

### Detalha a sala recem-criada
GET {{baseUrl}}/salas/{{salaId}}

> {%
    client.test("200", () => client.assert(response.status === 200));
%}

### Cadastra colaborador -> 201
POST {{baseUrl}}/colaboradores
Content-Type: application/json

{
  "nome": "Colaborador Teste",
  "email": "teste-{{$randomInt}}@colabspace.com",
  "departamento": "OPERACOES"
}

> {%
    client.test("201", () => client.assert(response.status === 201));
    client.test("header Location presente", () =>
        client.assert(response.headers.valueOf("Location") != null));
%}


### =============================================================
### 3. OS QUE REVELAM BUG
### =============================================================

### PUT mantendo o proprio nome -> 200 (NAO pode ser 409)
### Prova que o existsByNomeAndIdNot ignora a propria sala.
PUT {{baseUrl}}/salas/1
Content-Type: application/json

{
  "nome": "Sala Apollo",
  "capacidade": 12,
  "andar": 1,
  "recursos": ["PROJETOR", "AR_CONDICIONADO"]
}

> {%
    client.test("200 e nao 409", () =>
        client.assert(response.status === 200,
            "409 aqui significa que o AndIdNot nao esta funcionando"));
%}

### PUT com nome de OUTRA sala -> 409
PUT {{baseUrl}}/salas/1
Content-Type: application/json

{
  "nome": "Sala Gemini",
  "capacidade": 12,
  "andar": 1,
  "recursos": []
}

> {%
    client.test("409", () => client.assert(response.status === 409));
%}

### PUT sem "recursos" -> deve ZERAR (substituicao completa)
PUT {{baseUrl}}/salas/{{salaId}}
Content-Type: application/json

{
  "nome": "Sala Teste Sem Recursos",
  "capacidade": 8,
  "andar": 4
}

> {%
    client.test("200", () => client.assert(response.status === 200));
    client.test("recursos zerados", () =>
        client.assert(response.body.recursos.length === 0,
            "PUT e substituicao completa: campo ausente deve esvaziar"));
%}

### Inativa a sala de teste
PATCH {{baseUrl}}/salas/{{salaId}}/inativar

> {%
    client.test("200", () => client.assert(response.status === 200));
    client.test("resposta diz inativa", () => client.assert(response.body.ativa === false));
%}

### Confirma que INATIVOU NO BANCO (o teste de verdade do @Transactional)
GET {{baseUrl}}/salas/{{salaId}}

> {%
    client.test("persistiu no banco", () =>
        client.assert(response.body.ativa === false,
            "resposta do PATCH mudou mas o banco nao: falta @Transactional"));
%}

### Reativa
PATCH {{baseUrl}}/salas/{{salaId}}/ativar

> {%
    client.test("200 e ativa", () =>
        client.assert(response.status === 200 && response.body.ativa === true));
%}


### =============================================================
### 4. ERROS - nenhuma resposta pode conter "trace"
### =============================================================

### Sala inexistente -> 404
GET {{baseUrl}}/salas/999

> {%
    client.test("404", () => client.assert(response.status === 404));
    client.test("sem stack trace", () =>
        client.assert(!JSON.stringify(response.body).includes("trace")));
%}

### Id de tipo invalido -> 400
GET {{baseUrl}}/salas/abc

> {%
    client.test("400", () => client.assert(response.status === 400,
        "500 aqui significa que falta o handler de MethodArgumentTypeMismatchException"));
    client.test("sem stack trace", () =>
        client.assert(!JSON.stringify(response.body).includes("trace")));
%}

### Corpo vazio -> 400 com a lista de campos
POST {{baseUrl}}/salas
Content-Type: application/json

{}

> {%
    client.test("400", () => client.assert(response.status === 400));
    client.test("lista os campos reprovados", () =>
        client.assert(response.body.campos && response.body.campos.length > 0));
%}

### JSON truncado -> 400
POST {{baseUrl}}/salas
Content-Type: application/json

{"nome":

> {%
    client.test("400", () => client.assert(response.status === 400,
        "500 aqui significa que falta o handler de HttpMessageNotReadableException"));
    client.test("sem stack trace", () =>
        client.assert(!JSON.stringify(response.body).includes("trace")));
%}

### Enum inexistente -> 400
POST {{baseUrl}}/salas
Content-Type: application/json

{
  "nome": "Sala Invalida",
  "capacidade": 5,
  "andar": 1,
  "recursos": ["GELADEIRA"]
}

> {%
    client.test("400", () => client.assert(response.status === 400));
    client.test("sem vazar nome de classe interna", () =>
        client.assert(!JSON.stringify(response.body).includes("com.colabspace")));
%}

### Capacidade negativa -> 400
POST {{baseUrl}}/salas
Content-Type: application/json

{
  "nome": "Sala Negativa",
  "capacidade": -5,
  "andar": 1
}

> {%
    client.test("400", () => client.assert(response.status === 400));
%}

### Nome de sala duplicado -> 409
POST {{baseUrl}}/salas
Content-Type: application/json

{
  "nome": "Sala Apollo",
  "capacidade": 5,
  "andar": 1
}

> {%
    client.test("409", () => client.assert(response.status === 409));
%}

### Email de colaborador duplicado -> 409
POST {{baseUrl}}/colaboradores
Content-Type: application/json

{
  "nome": "Clone da Ana",
  "email": "ana.souza@colabspace.com",
  "departamento": "TECNOLOGIA"
}

> {%
    client.test("409", () => client.assert(response.status === 409));
%}

### Email malformado -> 400
POST {{baseUrl}}/colaboradores
Content-Type: application/json

{
  "nome": "Sem Email",
  "email": "nao-e-um-email",
  "departamento": "TECNOLOGIA"
}

> {%
    client.test("400", () => client.assert(response.status === 400));
%}

### Colaborador inexistente -> 404
GET {{baseUrl}}/colaboradores/999

> {%
    client.test("404", () => client.assert(response.status === 404));
    client.test("sem stack trace", () =>
        client.assert(!JSON.stringify(response.body).includes("trace")));
%}

### Metodo nao suportado na rota -> 405
POST {{baseUrl}}/salas/1
Content-Type: application/json

{}

> {%
    client.test("405", () => client.assert(response.status === 405,
        "vira 500 se voce adicionar o catch-all sem tratar essa excecao"));
%}
